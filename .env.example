# Copy this file to .env and fill in. Never commit .env or paste these values anywhere.
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=
# Optional phone alerts via ntfy.sh: install the ntfy app, subscribe to a long random topic, put it here.
# Treat the topic like a password. Only generic text ("Fyers login needed") is ever sent.
NTFY_TOPIC=
# Optional, written for you by the login. FYERS_PIN is added from the dashboard (Settings > Fyers login)
# to renew the daily token automatically for 15 days after each browser login.
FYERS_REFRESH_TOKEN=
FYERS_REFRESH_SAVED=
FYERS_PIN=
